# 复制成 .env 后填入真实值（.env 不要提交到 git）
# docker compose 用这个文件注入，容器 entrypoint 会据此生成 ~/.vibe-trading/.env 与 agent.json

# ---- LLM（必填）----
MINIMAX_API_KEY=sk-cp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
LANGCHAIN_PROVIDER=minimax
LANGCHAIN_MODEL_NAME=MiniMax-M2.7
LANGCHAIN_TEMPERATURE=0.0
TIMEOUT_SECONDS=120
MAX_RETRIES=2

# ---- 飞书通道（必填）----
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_DOMAIN=feishu

# ---- 其他 ----
VT_PORT=8000
TZ=Asia/Shanghai
